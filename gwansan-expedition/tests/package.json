{
  "name": "gwansan-expedition-dev",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler pages dev ../public --port 5000 --ip 127.0.0.1",
    "emulators": "firebase emulators:start --project demo-gwansan",
    "test:rules": "firebase emulators:exec --only firestore --project demo-gwansan \"node --test rules.test.js\"",
    "deploy:rules": "firebase deploy --only firestore:rules"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^3.0.4",
    "firebase": "^10.12.2",
    "firebase-tools": "^13.0.0",
    "wrangler": "^4.0.0"
  }
}
