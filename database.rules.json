{
  "rules": {
    ".read": true,
    "players": {
      "$sid": {
        ".write": "$sid.matches(/^[0-9A-Za-z]{1,12}$/)",
        ".validate": "newData.hasChildren(['x', 'y', 'm', 't'])"
      }
    },
    "food": {
      "$fid": {
        ".write": true
      }
    },
    "scores": {
      ".indexOn": [
        "best"
      ],
      "$sid": {
        ".write": "newData.exists() && (!data.child('best').exists() || newData.child('best').val() >= data.child('best').val()) && (!data.child('kills').exists() || newData.child('kills').val() >= data.child('kills').val()) && (!data.child('games').exists() || newData.child('games').val() >= data.child('games').val())",
        ".validate": "$sid.matches(/^[0-9A-Za-z]{1,12}$/)",
        "best": {
          ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 5000"
        },
        "kills": {
          ".validate": "newData.isNumber() && newData.val() <= (data.exists() ? data.val() : 0) + 1"
        },
        "games": {
          ".validate": "newData.isNumber() && newData.val() <= (data.exists() ? data.val() : 0) + 1"
        },
        "last": {
          ".validate": "newData.isNumber()"
        },
        "name": {
          ".validate": "newData.isString() && newData.val().length <= 20"
        },
        "sid": {
          ".validate": "newData.val() == $sid"
        },
        "ts": {
          ".validate": "newData.isNumber()"
        },
        "$other": {
          ".validate": false
        }
      }
    },
    "notices": {
      "$sid": {
        ".write": true
      }
    },
    "settings": {
      ".write": false
    },
    "roomIndex": {
      ".write": false
    },
    "rooms": {
      "$code": {
        "meta": {
          ".write": false
        },
        "state": {
          ".write": false
        },
        "standings": {
          ".write": false
        },
        "roundResults": {
          ".write": false
        },
        "members": {
          "$sid": {
            ".write": "root.child('rooms').child($code).child('meta').exists() && $sid.matches(/^[0-9A-Za-z]{1,12}$/)",
            ".validate": "newData.child('name').isString() && newData.child('name').val().length <= 20"
          }
        },
        "presence": {
          "$sid": {
            ".write": "root.child('rooms').child($code).child('meta').exists() && $sid.matches(/^[0-9A-Za-z]{1,12}$/)"
          }
        },
        "players": {
          "$sid": {
            ".write": "root.child('rooms').child($code).child('meta').exists() && $sid.matches(/^[0-9A-Za-z]{1,12}$/)",
            ".validate": "newData.hasChildren(['x', 'y', 'm', 't'])"
          }
        },
        "food": {
          "$fid": {
            ".write": "root.child('rooms').child($code).child('meta').exists()"
          }
        },
        "notices": {
          "$sid": {
            ".write": "root.child('rooms').child($code).child('meta').exists()"
          }
        },
        "roundScores": {
          "$rk": {
            "$sid": {
              ".write": "newData.exists() && $sid.matches(/^[0-9A-Za-z]{1,12}$/) && root.child('rooms').child($code).child('state/phase').val() == 'round' && root.child('rooms').child($code).child('state/roundKey').val() == $rk && now >= root.child('rooms').child($code).child('state/startAt').val() - 2000 && now <= root.child('rooms').child($code).child('state/endAt').val() + 10000 && (!data.child('best').exists() || newData.child('best').val() >= data.child('best').val()) && (!data.child('kills').exists() || newData.child('kills').val() >= data.child('kills').val())",
              "best": {
                ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 5000"
              },
              "kills": {
                ".validate": "newData.isNumber() && newData.val() <= (data.exists() ? data.val() : 0) + 1"
              },
              "name": {
                ".validate": "newData.isString() && newData.val().length <= 20"
              },
              "$other": {
                ".validate": false
              }
            }
          }
        }
      }
    },
    "omok": {
      ".write": false
    },
    "omokIndex": {
      ".write": false
    },
    "tetris": {
      "rooms": {
        ".write": false
      },
      "lobby": {
        "$rid": {
          "$sid": {
            ".write": "$sid.matches(/^[0-9A-Za-z]{1,12}$/) && (!newData.exists() || root.child('tetris/rooms/' + $rid).exists())",
            ".validate": "newData.hasChildren(['n', 't']) && newData.child('n').isString() && newData.child('n').val().length <= 20"
          }
        }
      },
      "boards": {
        "$rid": {
          "$sid": {
            ".write": "$sid.matches(/^[0-9A-Za-z]{1,12}$/) && (!newData.exists() || root.child('tetris/rooms/' + $rid).exists())",
            ".validate": "newData.hasChildren(['n', 'g', 'b']) && newData.child('b').isString() && newData.child('b').val().length <= 200 && newData.child('n').isString() && newData.child('n').val().length <= 20"
          }
        }
      },
      "entries": {
        "$rid": {
          "$gid": {
            "$sid": {
              ".write": "!data.exists() && newData.exists() && $sid.matches(/^[0-9A-Za-z]{1,12}$/) && root.child('tetris/rooms/' + $rid + '/game/id').val() == $gid && root.child('tetris/rooms/' + $rid + '/game/start').val() + 3000 > now",
              ".validate": "newData.hasChildren(['n']) && newData.child('n').isString() && newData.child('n').val().length <= 20"
            }
          }
        }
      },
      "results": {
        "$rid": {
          "$gid": {
            "$sid": {
              ".write": "!data.exists() && newData.exists() && root.child('tetris/entries/' + $rid + '/' + $gid + '/' + $sid).exists()",
              ".validate": "newData.hasChildren(['t']) && newData.child('t').val() == now"
            }
          }
        }
      },
      "attacks": {
        "$rid": {
          "$sid": {
            "$aid": {
              ".write": "!newData.exists() || root.child('tetris/rooms/' + $rid).exists()",
              ".validate": "newData.hasChildren(['l', 'g']) && newData.child('l').isNumber() && newData.child('l').val() >= 1 && newData.child('l').val() <= 20"
            }
          }
        }
      }
    }
  }
}
