rules_version = '2';

// 관산 게임왕 참가자 등록 보안 규칙
// - 학생(로그인 없음): 새 신청서 "생성"만 가능. 신청서 읽기·수정·삭제 불가.
// - 문서 ID = 학번 → 같은 학번으로 두 번째 신청하면 "수정"으로 취급되어 거부됨.
// - 선정 결과: 관리자가 "결과 공개"를 켠 뒤에만, 이름+학번으로 만든 키(SHA-256)로 자기 결과 1개만 조회 가능.
//   목록 조회는 불가 → 다른 학생의 이름·학번을 모르면 결과를 볼 수 없음.
// - 관리자: 아래 이메일로 로그인한 Google 계정만 신청 목록 읽기, 선정 결과 작성 가능.
service cloud.firestore {
  match /databases/{database}/documents {

    function isAdmin() {
      return request.auth != null
        && request.auth.token.email == "qjatjr7575@gmail.com"
        && request.auth.token.email_verified == true;
    }

    function validApplication(studentId) {
      let d = request.resource.data;
      return d.keys().hasOnly(['name', 'studentId', 'games', 'createdAt'])
        && d.keys().hasAll(['name', 'studentId', 'games', 'createdAt'])
        && studentId.matches('^[0-9]{5}$')
        && d.studentId == studentId
        && d.name is string && d.name.size() >= 1 && d.name.size() <= 20
        && d.games is list && d.games.size() >= 1 && d.games.size() <= 4
        && d.games.toSet().size() == d.games.size()
        && d.games.hasOnly(['끄투온라인', '테트리스', '오목', '지렁이 게임'])
        && d.createdAt == request.time;
    }

    match /applications/{studentId} {
      allow create: if validApplication(studentId);
      allow read: if isAdmin();
      allow update, delete: if false;
    }

    function resultsOpen() {
      let path = /databases/$(database)/documents/settings/results;
      return exists(path) && get(path).data.open == true;
    }

    function validResult() {
      let d = request.resource.data;
      return d.keys().hasOnly(['selected', 'applied', 'updatedAt'])
        && d.selected is list && d.applied is list
        && d.selected.hasOnly(d.applied)
        && d.applied.hasOnly(['끄투온라인', '테트리스', '오목', '지렁이 게임']);
    }

    // 선정 결과 (문서 ID = SHA-256(학번+이름), 내용에는 이름·학번 없음)
    match /results/{key} {
      allow get: if key.matches('^[0-9a-f]{64}$') && resultsOpen();
      allow read: if isAdmin();
      allow create, update: if isAdmin() && key.matches('^[0-9a-f]{64}$') && validResult();
      allow delete: if isAdmin();
    }

    // 결과 공개 스위치 { open: bool } — 누구나 읽기, 관리자만 쓰기
    match /settings/results {
      allow get: if true;
      allow write: if isAdmin()
        && request.resource.data.keys().hasOnly(['open', 'updatedAt'])
        && request.resource.data.open is bool;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
